{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@plinth/worker#build": {
      "dependsOn": ["@plinth/web#build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@plinth/worker#test": {
      "dependsOn": ["@plinth/web#build"]
    },
    "test:e2e": {
      "dependsOn": ["@plinth/web#build"],
      "cache": false,
      "passThroughEnv": ["PLINTH_E2E_PORT", "PLINTH_E2E_SHOTS", "CI"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@mr0b0t0/plinth#build": {
      "dependsOn": ["^build"],
      "outputs": ["runtime/**"]
    }
  }
}

# Local secrets for `wrangler dev`. scripts/setup.mjs writes .dev.vars with fresh random values.
SESSION_SECRET=dev-session-secret-change-me-0123456789abcdef
TOKEN_SIGNING_KEY=dev-token-signing-key-change-me-0123456789abcdef
# Single-user mode only: bearer token for the admin user.
ADMIN_TOKEN=
SENDGRID_API_KEY=
RESEND_API_KEY=
# Optional overrides of wrangler.jsonc vars. Per-version limits: MAX_VERSION_BYTES from 1048576 to
# 67108864 bytes (default 52428800), MAX_ASSETS_PER_VERSION from 1 to 900 (default 511).
# MAX_VERSION_BYTES=52428800
# MAX_ASSETS_PER_VERSION=511
# Design PNG and PDF export, in effect only with a Browser Rendering binding (BROWSER), which
# `wrangler dev` runs without: DESIGN_EXPORT (default true), DESIGN_EXPORTS_PER_HOUR from 1 to 1000
# (default 30) per person.
# DESIGN_EXPORT=true
# DESIGN_EXPORTS_PER_HOUR=30

{
  "name": "@plinth/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "node scripts/check-config.mjs --warn && wrangler deploy --dry-run --outdir dist",
    "check-config": "node scripts/check-config.mjs",
    "deploy:production": "node scripts/check-config.mjs wrangler.production.jsonc && wrangler deploy --config wrangler.production.jsonc",
    "deploy:staging": "node scripts/check-config.mjs wrangler.staging.jsonc && wrangler deploy --config wrangler.staging.jsonc",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --strict-vars=false",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "admin": "node scripts/admin.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@plinth/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "tldts": "7.4.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.158.0",
    "@modelcontextprotocol/client": "2.4.0"
  }
}

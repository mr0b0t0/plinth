// Local development config. Staging and self-hosted deploys use a per-environment copy written
// by scripts/setup.mjs. Every host, limit and provider is a var; secrets live in .dev.vars locally.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plinth",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plinth",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "plinth-files" }],
  "vars": {
    "ENVIRONMENT": "development",
    "APP_HOST": "app.localhost:8787",
    "CONTENT_HOST": "content.localhost:8787",
    "PUBLIC_SCHEME": "http",
    "EMAIL_PROVIDER": "console",
    "EMAIL_FROM": "Plinth <noreply@plinth.localhost>",
    "MAX_ARTIFACTS_PER_USER": "100",
    "MAX_PUBLISHES_PER_HOUR": "60",
    "MAX_VERSION_BYTES": "52428800",
    "MAX_ASSETS_PER_VERSION": "511",
    "CDN_ALLOWLIST": "",
    "SINGLE_USER_MODE": "false",
    "ADMIN_EMAIL": "",
    "ALLOW_PUBLIC_VISIBILITY": "false",
    "PUBLIC_MIN_ACCOUNT_AGE_HOURS": "72",
    "STAGING_CONTENT_FALLBACK": "false",
    "CONTENT_ISOLATION": "origin",
    "ALLOW_SHARED_DATA": "true",
    "SHOW_SOURCE_LINK": "true",
    "DATA_MAX_DOCS_PER_ARTIFACT": "1000",
    "DATA_MAX_BYTES_PER_ARTIFACT": "1048576",
    "DATA_MAX_BYTES_PER_USER": "16777216",
    "DATA_MAX_DOC_BYTES": "16384",
    "DATA_WRITES_PER_VIEWER_PER_HOUR": "300",
    "DATA_WRITES_PER_ARTIFACT_PER_HOUR": "2000",
    "DEV_OUTBOX": "true",
    "DEV_IGNORE_CLIENT_IP": "false",
    "DEV_SEED": "false",
    "OPERATOR_NAME": "",
    "OPERATOR_ADDRESS": "",
    "OPERATOR_REGISTRATION": "",
    "OPERATOR_EMAIL": "",
    "OPERATOR_HOSTING": ""
  }
}

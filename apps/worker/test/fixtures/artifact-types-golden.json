{
  "resolveSource": {
    "publish default html": {
      "ok": {
        "type": "html",
        "text": "<p>x</p>"
      }
    },
    "publish html with content": {
      "error": {
        "code": "invalid_input",
        "message": "content is for typed artifacts: pass type \"doc\" or \"slides\", or send html",
        "details": {
          "type": "html",
          "field": "content"
        }
      }
    },
    "publish html without html": {
      "error": {
        "code": "invalid_input",
        "message": "html is required (or pass type \"doc\" with content)",
        "details": {
          "type": "html",
          "field": "html"
        }
      }
    },
    "publish explicit html": {
      "ok": {
        "type": "html",
        "text": "<!doctype html><html><body>x</body></html>"
      }
    },
    "publish doc": {
      "ok": {
        "type": "doc",
        "text": "# Plan\n\nText"
      }
    },
    "publish doc with html": {
      "error": {
        "code": "invalid_input",
        "message": "type doc takes Markdown in content, not html",
        "details": {
          "type": "doc",
          "field": "html"
        }
      }
    },
    "publish doc without content": {
      "error": {
        "code": "invalid_input",
        "message": "type doc needs its Markdown in content",
        "details": {
          "type": "doc",
          "field": "content"
        }
      }
    },
    "publish doc with a whole document": {
      "error": {
        "code": "invalid_input",
        "message": "content for type doc is Markdown. To publish HTML, use type \"html\" and the html field.",
        "details": {
          "type": "doc",
          "field": "content"
        }
      }
    },
    "publish doc with <html>": {
      "error": {
        "code": "invalid_input",
        "message": "content for type doc is Markdown. To publish HTML, use type \"html\" and the html field.",
        "details": {
          "type": "doc",
          "field": "content"
        }
      }
    },
    "publish doc mentioning html": {
      "ok": {
        "type": "doc",
        "text": "Use <html> tags"
      }
    },
    "publish unknown type": {
      "error": {
        "code": "invalid_input",
        "message": "Unknown artifact type: deck",
        "details": {
          "type": "deck",
          "field": "type"
        }
      }
    },
    "publish prototype key": {
      "error": {
        "code": "invalid_input",
        "message": "Unknown artifact type: toString",
        "details": {
          "type": "toString",
          "field": "type"
        }
      }
    },
    "update html": {
      "ok": {
        "type": "html",
        "text": "<p>y</p>"
      }
    },
    "update html with content": {
      "error": {
        "code": "invalid_input",
        "message": "This artifact is an HTML page: send html. The type cannot change.",
        "details": {
          "type": "html",
          "field": "content"
        }
      }
    },
    "update html without html": {
      "error": {
        "code": "invalid_input",
        "message": "html is required (or pass type \"doc\" with content)",
        "details": {
          "type": "html",
          "field": "html"
        }
      }
    },
    "update doc": {
      "ok": {
        "type": "doc",
        "text": "# y"
      }
    },
    "update doc with html": {
      "error": {
        "code": "invalid_input",
        "message": "This artifact is a doc: send its Markdown as content. The type cannot change.",
        "details": {
          "type": "doc",
          "field": "html"
        }
      }
    },
    "update doc without content": {
      "error": {
        "code": "invalid_input",
        "message": "This artifact is a doc: send its Markdown as content.",
        "details": {
          "type": "doc",
          "field": "content"
        }
      }
    },
    "update doc with a whole document": {
      "error": {
        "code": "invalid_input",
        "message": "content for type doc is Markdown. To publish HTML, use type \"html\" and the html field.",
        "details": {
          "type": "doc",
          "field": "content"
        }
      }
    },
    "update doc ignores type": {
      "ok": {
        "type": "doc",
        "text": "# y"
      }
    }
  },

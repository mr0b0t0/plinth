{
  "name": "plinth",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "biome check .",
    "format": "biome check --write .",
    "setup": "node scripts/setup.mjs",
    "seed": "node scripts/seed.mjs",
    "openapi": "node scripts/openapi.mjs",
    "local:start": "node scripts/local-start.mjs",
    "test:local": "node e2e/local/smoke.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
